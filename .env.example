# Copy to .env and adjust. No secrets are required: all data sources are public.

# Backend
BUSTGUARD_DATA_DIR=../data            # relative to backend/
BUSTGUARD_ARTIFACTS=../data/artifacts # trained models + exported API payloads
BUSTGUARD_OFFLINE=1                   # 1 = never hit the network at serve time (demo mode)
BUSTGUARD_CORS_ORIGINS=http://localhost:5173

# Optional: Open-Meteo commercial key (free tier works without it, but is rate limited)
OPEN_METEO_API_KEY=

# Frontend (Vite)
VITE_API_BASE=http://localhost:8000
